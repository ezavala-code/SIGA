{
  "name": "@siga/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "auth:bootstrap:admin": "npm run build && node dist/modules/auth/bootstrap.js",
    "auth:bootstrap:production": "npm run build && node dist/modules/auth/bootstrap-production-admin.js",
    "auth:bootstrap:local-test-profiles": "npm run build && node dist/modules/personas/bootstrap-local-test-profiles.js",
    "auth:bootstrap:local-users": "npm run build && node dist/modules/personas/bootstrap-local-users.js",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "pretest:unit": "npm run db:generate",
    "pretest:integration": "npm run db:generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && concurrently -k \"tsc -p tsconfig.build.json --watch\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test:unit": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects unit --runInBand",
    "test:integration": "node ../../scripts/test-integration.mjs",
    "auth:provision:local": "npm run build && node dist/modules/personas/provisionar-acceso-local.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@siga/contracts": "0.1.0",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.7",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14"
  }
}
