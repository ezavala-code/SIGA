# Plantilla LOCAL. npm run setup genera contraseñas aleatorias en .env.
NODE_ENV=development
PORT=3000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
POSTGRES_USER=siga
POSTGRES_PASSWORD=GENERAR_CON_NPM_RUN_SETUP
POSTGRES_DB=siga_dev
POSTGRES_APP_USER=siga_app
POSTGRES_APP_PASSWORD=GENERAR_APP_DB_PASSWORD
SIGA_VERSION=0.1.0
POSTGRES_PORT=5432
WEB_PORT=8080
DATABASE_URL=postgresql://siga:GENERAR_CON_NPM_RUN_SETUP@127.0.0.1:5432/siga_dev
TEST_POSTGRES_PASSWORD=GENERAR_CON_NPM_RUN_SETUP
TEST_DATABASE_URL=postgresql://siga_test:GENERAR_CON_NPM_RUN_SETUP@127.0.0.1:5433/siga_test
JWT_SECRET=GENERAR_JWT_SECRET
JWT_TTL_SECONDS=1800
EXIGIR_PRERREQUISITOS=true
CERTIFICATES_DIR=.local/certificados
COOKIE_SECURE=false
